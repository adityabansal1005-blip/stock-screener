# Copy to .env locally. Keep values out of GitHub and chat.
# Everything below is optional for opening the dashboard.
# Your own Groww developer credentials provide market data when entitled.
GROWW_API_KEY=
GROWW_API_SECRET=
# Optional existing Claude report feature
ANTHROPIC_API_KEY=
# Optional separate TradingAgents research feature (requires optional setup)
GOOGLE_API_KEY=
TRADINGAGENTS_MODEL=gemini-3.5-flash
# Optional alerts: leave both blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional alternate data providers
TRUEDATA_USER=
TRUEDATA_PASSWORD=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Start small; choose full NSE from the dashboard when ready
SCAN_UNIVERSE=nifty50
ACCOUNT_SIZE_INR=100000
RISK_PER_TRADE_PCT=1
AI_ANALYSE_TOP_N=0
ALERT_MIN_SCORE=4
# Manual scans by default
AUTO_SCAN_HOURS=
STARTUP_SCAN_ENABLED=false
FULL_SCAN_ENABLED=false
FULL_SCAN_AT=18:30
FULL_SCAN_UNIVERSE=all_nse
PORT=8000
